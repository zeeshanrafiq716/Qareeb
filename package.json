{
  "name": "qareeb-app",
  "version": "1.0.0",
  "private": true,
  "description": "Qareeb App Phase 1 backend",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "start:staging": "node --env-file=.env.staging src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "node src/db/setup.js",
    "test": "vitest run --reporter=verbose",
    "test:api": "vitest run --reporter=verbose",
    "test:staging": "node scripts/staging-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
