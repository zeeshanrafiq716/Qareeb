NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:database%40123@127.0.0.1:5432/qareeb
DATABASE_URL_TEST=postgres://postgres:database%40123@127.0.0.1:5432/qareeb_test
EMBEDDED_POSTGRES=false

JWT_SECRET=change-this-to-a-long-random-secret
JWT_PROVIDER_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=12h

ADMIN_EMAIL=admin@qareeb.app
ADMIN_PASSWORD=QareebAdmin@123
ADMIN_NAME=Qareeb Admin

OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RETURN_IN_RESPONSE=true
OTP_STATIC_CODE=

UPLOAD_DIR=uploads
MAX_PHOTO_MB=5
MAX_DOCUMENT_MB=10

LOG_LEVEL=info
CORS_ORIGIN=*
AUTO_MIGRATE=true
AUTO_SEED=true

REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=120
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_PHONE=5
OTP_RATE_LIMIT_PER_IP=15
ADMIN_LOGIN_RATE_LIMIT=10

FCM_ENABLED=false
FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

MONITORING_WEBHOOK_URL=
