NODE_ENV=staging
PORT=3000

DATABASE_URL=postgres://postgres:postgres@postgres:5432/qareeb
EMBEDDED_POSTGRES=false
AUTO_MIGRATE=true
AUTO_SEED=true

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379

JWT_SECRET=replace-with-long-random-secret-in-production
JWT_PROVIDER_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=12h

ADMIN_EMAIL=admin@qareeb.app
ADMIN_PASSWORD=change-me-before-deploy
ADMIN_NAME=Qareeb Admin

OTP_RETURN_IN_RESPONSE=false
OTP_STATIC_CODE=

UPLOAD_DIR=uploads
CORS_ORIGIN=https://admin.yourdomain.com,https://app.yourdomain.com
LOG_LEVEL=info

PRESENCE_STALE_SECONDS=90
LOCATION_MIN_INTERVAL_SECONDS=30
LOCATION_MAX_INTERVAL_SECONDS=60
PRIVACY_MASK_RADIUS_METERS=300
