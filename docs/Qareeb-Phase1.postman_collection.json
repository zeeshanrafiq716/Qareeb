{
  "info": {
    "name": "Qareeb Phase 1",
    "description": "Manual API testing — provider registration + admin verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "phone", "value": "03001234567" },
    { "key": "otp", "value": "" },
    { "key": "providerToken", "value": "" },
    { "key": "providerId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "adminEmail", "value": "admin@qareeb.app" },
    { "key": "adminPassword", "value": "QareebAdmin@123" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "GET /api/v1/health",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health" }
        }
      ]
    },
    {
      "name": "Provider",
      "item": [
        {
          "name": "1. List categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data[0]) {",
                  "  pm.collectionVariables.set('categoryId', json.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories" }
        },
        {
          "name": "2. Request OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.otp) {",
                  "  pm.collectionVariables.set('otp', json.data.otp);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/otp/request"
          }
        },
        {
          "name": "3. Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.collectionVariables.set('providerToken', json.data.token);",
                  "  pm.collectionVariables.set('providerId', json.data.provider.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/otp/verify"
          }
        },
        {
          "name": "4. Update profile (form-data + photo)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Ali Plumber", "type": "text" },
                { "key": "categoryId", "value": "{{categoryId}}", "type": "text" },
                { "key": "city", "value": "Lahore", "type": "text" },
                { "key": "address", "value": "Main Bazaar", "type": "text" },
                { "key": "latitude", "value": "31.5204", "type": "text" },
                { "key": "longitude", "value": "74.3587", "type": "text" },
                { "key": "photo", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/v1/providers/me/profile"
          }
        },
        {
          "name": "5. Submit verification document",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "documentType", "value": "cnic", "type": "text" },
                { "key": "document", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/v1/providers/me/verification"
          }
        },
        {
          "name": "6. Get my profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerToken}}" }],
            "url": "{{baseUrl}}/api/v1/providers/me"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "1. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('adminToken', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/auth/login"
          }
        },
        {
          "name": "2. List providers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/providers?status=pending_verification"
          }
        },
        {
          "name": "3. Provider details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/providers/{{providerId}}"
          }
        },
        {
          "name": "4. Approve",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Approved in manual test\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/providers/{{providerId}}/approve"
          }
        },
        {
          "name": "5. Reject",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Rejected in manual test\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/providers/{{providerId}}/reject"
          }
        },
        {
          "name": "Categories — list",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/categories"
          }
        }
      ]
    }
  ]
}
