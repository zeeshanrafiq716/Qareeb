# =============================================================================
# PHASE 5 — Infrastructure (rate limits, FCM token, readiness, empty map)
# =============================================================================

Write-Host "`n========== PHASE 5 START ==========" -ForegroundColor Green
if (-not $base) { $base = "http://127.0.0.1:3000" }

Write-Host "`n[P5-1] Readiness (DB + Redis)" -ForegroundColor Cyan
Invoke-RestMethod "$base/health/ready" | ConvertTo-Json -Depth 6

Write-Host "`n[P5-2] Empty customer map (no online providers)" -ForegroundColor Cyan
$empty = Invoke-RestMethod "$base/api/v1/discovery/search?latitude=31.52&longitude=74.35&radiusKm=2"
$empty.meta.emptyState | ConvertTo-Json -Depth 5

Write-Host "`n[P5-3] Provider push token (FCM register)" -ForegroundColor Cyan
if ($providerToken) {
  Invoke-RestMethod -Method Put -Uri "$base/api/v1/providers/me/push-token" `
    -Headers @{ Authorization = "Bearer $providerToken" } `
    -ContentType "application/json" `
    -Body '{"token":"dev-fcm-token-sample-1234567890","platform":"android"}' | ConvertTo-Json
}

Write-Host "`nField tests (battery, road, RTL): docs/FIELD_TEST_CHECKLIST.md" -ForegroundColor DarkGray
Write-Host "`n========== PHASE 5 DONE ==========" -ForegroundColor Green


