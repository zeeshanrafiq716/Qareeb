# =============================================================================
# Qareeb — Manual testing (PowerShell)
# =============================================================================
#
# Terminal 1:
#   cd "D:\projects\Qareeb App"
#   npm run dev
#
# Terminal 2:
#   Phase 1 block ALONE chalao, phir Phase 2 block (approved token chahiye)
#
# Admin: admin@qareeb.app / QareebAdmin@123
# OTP dev mode: response.data.otp
#
# Notes:
#   - curl.exe use karein (curl alias mat)
#   - $providerId use karein — $pid mat
#   - "PostGIS not available" WARN = OK (haversine use hota hai)
#   - Redis: REDIS_ENABLED=false → in-memory presence (no Redis needed)
# =============================================================================


# =============================================================================
# PHASE 1 ONLY — Registration + Admin approval
# Expected end: provider status = approved
# =============================================================================

$base = "http://127.0.0.1:3000"
$phone = "03001234567"    # dubara test: naya number e.g. 03005556677

Write-Host "`n========== PHASE 1 START ==========" -ForegroundColor Green

Write-Host "`n[P1-1] Health" -ForegroundColor Cyan
Invoke-RestMethod "$base/api/v1/health" | ConvertTo-Json

Write-Host "`n[P1-2] Public categories" -ForegroundColor Cyan
$catId = (Invoke-RestMethod "$base/api/v1/categories").data[0].id
Write-Host "categoryId:" $catId

Write-Host "`n[P1-3] OTP request" -ForegroundColor Cyan
$otpRes = Invoke-RestMethod -Method Post -Uri "$base/api/v1/auth/otp/request" `
  -ContentType "application/json" -Body (@{ phone = $phone } | ConvertTo-Json)
$otpRes.data | ConvertTo-Json
$otp = $otpRes.data.otp

Write-Host "`n[P1-4] OTP verify" -ForegroundColor Cyan
$verify = Invoke-RestMethod -Method Post -Uri "$base/api/v1/auth/otp/verify" `
  -ContentType "application/json" -Body (@{ phone = $phone; otp = $otp } | ConvertTo-Json)
$providerToken = $verify.data.token
$providerId = $verify.data.provider.id
Write-Host "status:" $verify.data.provider.status
Write-Host "QRB id:" $verify.data.provider.providerId
Write-Host "uuid:" $providerId

Write-Host "`n[P1-5] Demo PNG" -ForegroundColor Cyan
$png = Join-Path $env:TEMP "qareeb-demo.png"
[IO.File]::WriteAllBytes($png, [Convert]::FromBase64String("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="))

Write-Host "`n[P1-6] Profile + photo" -ForegroundColor Cyan
curl.exe -s -X PUT "$base/api/v1/providers/me/profile" `
  -H "Authorization: Bearer $providerToken" `
  -F "name=Ali Plumber" -F "categoryId=$catId" -F "city=Lahore" `
  -F "address=Main Bazaar" -F "latitude=31.5204" -F "longitude=74.3587" `
  -F "photo=@$png"

Write-Host "`n[P1-7] Verification document" -ForegroundColor Cyan
curl.exe -s -X POST "$base/api/v1/providers/me/verification" `
  -H "Authorization: Bearer $providerToken" `
  -F "documentType=cnic" -F "document=@$png"

Write-Host "`n[P1-8] Provider me (expect pending_verification)" -ForegroundColor Cyan
Invoke-RestMethod -Uri "$base/api/v1/providers/me" `
  -Headers @{ Authorization = "Bearer $providerToken" } | ConvertTo-Json -Depth 5

Write-Host "`n[P1-9] Admin login" -ForegroundColor Cyan
$admin = Invoke-RestMethod -Method Post -Uri "$base/api/v1/admin/auth/login" `
  -ContentType "application/json" `
  -Body (@{ email = "admin@qareeb.app"; password = "QareebAdmin@123" } | ConvertTo-Json)
$adminToken = $admin.data.token

Write-Host "`n[P1-10] Admin provider detail" -ForegroundColor Cyan
Invoke-RestMethod -Uri "$base/api/v1/admin/providers/$providerId" `
  -Headers @{ Authorization = "Bearer $adminToken" } `
  | Select-Object -ExpandProperty data | Select-Object status, providerId, name

Write-Host "`n[P1-11] Pending list" -ForegroundColor Cyan
Invoke-RestMethod -Uri "$base/api/v1/admin/providers?status=pending_verification" `
  -Headers @{ Authorization = "Bearer $adminToken" } | ConvertTo-Json -Depth 3

Write-Host "`n[P1-12] Approve (skip if already approved)" -ForegroundColor Cyan
try {
  Invoke-RestMethod -Method Post -Uri "$base/api/v1/admin/providers/$providerId/approve" `
    -Headers @{ Authorization = "Bearer $adminToken" } `
    -ContentType "application/json" -Body '{"reason":"Phase 1 manual test"}' `
    | ConvertTo-Json -Depth 4
} catch {
  Write-Host $_.ErrorDetails.Message -ForegroundColor Yellow
}

Write-Host "`n[P1-13] Final status (expect approved)" -ForegroundColor Cyan
Invoke-RestMethod -Uri "$base/api/v1/providers/me" `
  -Headers @{ Authorization = "Bearer $providerToken" } | ConvertTo-Json -Depth 5

Write-Host "`n========== PHASE 1 DONE ==========" -ForegroundColor Green
Write-Host "Saved: providerToken, adminToken, providerId, catId, phone"
Write-Host "Ab Phase 2 block alag se chalao (neeche)"


# =============================================================================
# PHASE 2 ONLY — Presence + location + discovery
# PEHLE: Phase 1 complete + status approved
# Agar variables khali hon to [P2-0] chalao
# =============================================================================

# --- Uncomment sirf agar naya session ho / variables missing hon ---
# $base = "http://127.0.0.1:3000"
# $phone = "03001234567"
# $otp = (Invoke-RestMethod -Method Post -Uri "$base/api/v1/auth/otp/request" -ContentType "application/json" -Body (@{phone=$phone}|ConvertTo-Json)).data.otp
# $verify = Invoke-RestMethod -Method Post -Uri "$base/api/v1/auth/otp/verify" -ContentType "application/json" -Body (@{phone=$phone;otp=$otp}|ConvertTo-Json)
