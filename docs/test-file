# $providerId = $verify.data.provider.id
# $adminToken = (Invoke-RestMethod -Method Post -Uri "$base/api/v1/admin/auth/login" -ContentType "application/json" -Body '{"email":"admin@qareeb.app","password":"QareebAdmin@123"}').data.token
# Write-Host "Provider status:" $verify.data.provider.status

Write-Host "`n========== PHASE 2 START ==========" -ForegroundColor Green

Write-Host "`n[P2-1] Presence REST (provider)" -ForegroundColor Cyan
Invoke-RestMethod -Uri "$base/api/v1/providers/me/presence" `
  -Headers @{ Authorization = "Bearer $providerToken" } | ConvertTo-Json -Depth 6

Write-Host "`n[P2-2] Location update (1st = accepted)" -ForegroundColor Cyan
Invoke-RestMethod -Method Put -Uri "$base/api/v1/providers/me/location" `
  -Headers @{ Authorization = "Bearer $providerToken" } `
  -ContentType "application/json" `
  -Body '{"latitude":31.5204,"longitude":74.3587}' | ConvertTo-Json

Write-Host "`n[P2-3] Location throttle (2nd <30s = rejected OR accepted=false)" -ForegroundColor Cyan
Invoke-RestMethod -Method Put -Uri "$base/api/v1/providers/me/location" `
  -Headers @{ Authorization = "Bearer $providerToken" } `
  -ContentType "application/json" `
  -Body '{"latitude":31.5205,"longitude":74.3588}' | ConvertTo-Json

Write-Host "`n[P2-4] WebSocket online + location (project folder)" -ForegroundColor Cyan
Write-Host '  cd "D:\projects\Qareeb App"'
Write-Host "  node scripts/socket-presence-demo.mjs `$providerToken"
Write-Host "  Expect: connected, presence:state, location_ack accepted=true"

Write-Host "`n[P2-5] Admin online providers" -ForegroundColor Cyan
Invoke-RestMethod -Uri "$base/api/v1/admin/providers/online" `
  -Headers @{ Authorization = "Bearer $adminToken" } | ConvertTo-Json -Depth 4

Write-Host "`n[P2-6] Customer discovery (privacy — approximate ~300m, NOT exact GPS)" -ForegroundColor Cyan
Invoke-RestMethod -Uri "$base/api/v1/discovery/nearby?latitude=31.5204&longitude=74.3587&radiusKm=10" `
  | ConvertTo-Json -Depth 6

Write-Host "`n[P2-7] Presence after socket (optional)" -ForegroundColor Cyan
Invoke-RestMethod -Uri "$base/api/v1/providers/me/presence" `
  -Headers @{ Authorization = "Bearer $providerToken" } | ConvertTo-Json -Depth 6

Write-Host "`n========== PHASE 2 DONE ==========" -ForegroundColor Green


# =============================================================================
# PHASE 3 ONLY — Customer discovery + provider profile
# PEHLE: Phase 1 + 2 (approved, online, location set) OR variables set
# =============================================================================

Write-Host "`n========== PHASE 3 START ==========" -ForegroundColor Green

# --- Phase 3 defaults (safe if you paste P3-4 alone in a new PowerShell window) ---
if (-not $base) { $base = "http://127.0.0.1:3000" }
if (-not $customerLat) { $customerLat = 31.5204; $customerLng = 74.3587 }
if (-not $customerSession) { $customerSession = [guid]::NewGuid().ToString() }
# Invoke-RestMethod throws NullReferenceException if X-Customer-Session header value is $null

Write-Host "`n[P3-1] Discovery categories (customer selection)" -ForegroundColor Cyan
$discCats = Invoke-RestMethod "$base/api/v1/discovery/categories"
$discCats.data | ConvertTo-Json
$discCategorySlug = $discCats.data[0].slug
Write-Host "categorySlug:" $discCategorySlug

Write-Host "`n[P3-2] Customer location + search (list + map)" -ForegroundColor Cyan
$customerLat = 31.5204
$customerLng = 74.3587
$search = Invoke-RestMethod -Uri "$base/api/v1/discovery/search?latitude=$customerLat&longitude=$customerLng&radiusKm=10&categorySlug=$discCategorySlug"
$search.data.list | ConvertTo-Json -Depth 6
Write-Host "map markers:" $search.data.map.markers.Count
Write-Host "geoEngine:" $search.meta.geoEngine

Write-Host "`n[P3-3] Legacy nearby list" -ForegroundColor Cyan
Invoke-RestMethod -Uri "$base/api/v1/discovery/nearby?latitude=$customerLat&longitude=$customerLng&radiusKm=10" `
  | ConvertTo-Json -Depth 5

Write-Host "`n[P3-4] Search with funnel session (list impressions)" -ForegroundColor Cyan
Write-Host "customerSession:" $customerSession
# Agar error aaye: npm run dev chal raha ho + migration 006 (node src/db/migrate.js)
try {
  $search = Invoke-RestMethod -Uri "$base/api/v1/discovery/search?latitude=$customerLat&longitude=$customerLng&radiusKm=10&categorySlug=$discCategorySlug&sessionId=$customerSession" `
    -Headers @{ "X-Customer-Session" = $customerSession }
} catch {
  Write-Host "Request failed — use curl for full body:" -ForegroundColor Red
  curl.exe -sS "$base/api/v1/discovery/search?latitude=$customerLat&longitude=$customerLng&radiusKm=10&categorySlug=$discCategorySlug&sessionId=$customerSession" `
    -H "X-Customer-Session: $customerSession"
  throw
}
$search.data.list | ConvertTo-Json -Depth 5

Write-Host "`n[P3-5] Public provider profile + direct contact (tel / WhatsApp / share location)" -ForegroundColor Cyan
$qrbId = ($search.data.list | Select-Object -First 1).providerId
if ($qrbId) {
  $profile = Invoke-RestMethod -Uri "$base/api/v1/discovery/providers/$qrbId?latitude=$customerLat&longitude=$customerLng&sessionId=$customerSession"
  $profile.data.contact | ConvertTo-Json -Depth 6
  Write-Host "Call URL:" $profile.data.contact.actions.call.url
  Write-Host "WhatsApp:" $profile.data.contact.actions.whatsapp.url
} else {
  Write-Host "No providers in search — run Phase 2 location/socket first" -ForegroundColor Yellow
}

Write-Host "`n[P3-6] Log contact tap (call / WhatsApp — opens on device, not on Qareeb)" -ForegroundColor Cyan
if ($qrbId) {
  Invoke-RestMethod -Method Post -Uri "$base/api/v1/discovery/events" `
    -ContentType "application/json" `
    -Body (@{
      sessionId = $customerSession
      event     = "call_click"
      providerPublicId = $qrbId
      latitude  = $customerLat
      longitude = $customerLng
    } | ConvertTo-Json) | ConvertTo-Json
}

Write-Host "`n[P3-7] Admin provider funnel (views, clicks, calls)" -ForegroundColor Cyan
if ($providerId) {
  Invoke-RestMethod -Uri "$base/api/v1/admin/providers/$providerId/funnel?days=30" `
    -Headers @{ Authorization = "Bearer $adminToken" } | ConvertTo-Json -Depth 5
}

Write-Host "`n========== PHASE 3 DONE (category -> search -> profile -> call/WhatsApp in 4 taps) ==========" -ForegroundColor Green


# =============================================================================
# PHASE 4 ONLY — Admin panel APIs + analytics
# PEHLE: $adminToken set (Phase 1) ya neeche login
# =============================================================================

Write-Host "`n========== PHASE 4 START ==========" -ForegroundColor Green
if (-not $base) { $base = "http://127.0.0.1:3000" }
if (-not $adminToken) {
  $adminLogin = Invoke-RestMethod -Method Post -Uri "$base/api/v1/admin/auth/login" `
    -ContentType "application/json" `
    -Body '{"email":"admin@qareeb.app","password":"QareebAdmin@123"}'
  $adminToken = $adminLogin.data.token
}

Write-Host "`n[P4-1] Lookup provider by QRB id or phone" -ForegroundColor Cyan
if ($qrbId) {
  Invoke-RestMethod -Uri "$base/api/v1/admin/providers/lookup?q=$qrbId" `
    -Headers @{ Authorization = "Bearer $adminToken" } | ConvertTo-Json -Depth 4
} elseif ($providerId) {
  Invoke-RestMethod -Uri "$base/api/v1/admin/providers/lookup?q=03001234567" `
    -Headers @{ Authorization = "Bearer $adminToken" } | ConvertTo-Json -Depth 4
}

Write-Host "`n[P4-2] Live admin map (online / offline / suspended — exact GPS)" -ForegroundColor Cyan
$adminMap = Invoke-RestMethod -Uri "$base/api/v1/admin/providers/map" `
  -Headers @{ Authorization = "Bearer $adminToken" }
Write-Host "summary:" ($adminMap.data.summary | ConvertTo-Json -Compress)
$adminMap.data.markers | Select-Object -First 3 | ConvertTo-Json -Depth 5

Write-Host "`n[P4-3] Platform funnel analytics" -ForegroundColor Cyan
Invoke-RestMethod -Uri "$base/api/v1/admin/analytics/funnel?days=30" `
  -Headers @{ Authorization = "Bearer $adminToken" } | ConvertTo-Json -Depth 5

Write-Host "`n[P4-4] Global call logs" -ForegroundColor Cyan
Invoke-RestMethod -Uri "$base/api/v1/admin/call-logs?limit=10" `
  -Headers @{ Authorization = "Bearer $adminToken" } | ConvertTo-Json -Depth 5

Write-Host "`n[P4-5] Admin categories (manage)" -ForegroundColor Cyan
Invoke-RestMethod -Uri "$base/api/v1/admin/categories" `
  -Headers @{ Authorization = "Bearer $adminToken" } | ConvertTo-Json -Depth 4

Write-Host "`n========== PHASE 4 DONE ==========" -ForegroundColor Green
Write-Host "Production: docs/PHASE4_ADMIN.md + docker compose up -d --build api" -ForegroundColor DarkGray


